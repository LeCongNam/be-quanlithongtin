DATABASE_URL="mysql://qltt:qltt_password@localhost:3306/qltv_nhom8"
# DB cloud (vd. Aiven) thêm ?ssl-mode=REQUIRED vào DATABASE_URL (mã hóa, không kiểm chứng chứng chỉ).
# Muốn kiểm chứng chứng chỉ thì đặt thêm DATABASE_SSL_CA = nội dung PEM của CA (hoặc dùng ssl-mode=VERIFY_CA).
# DATABASE_SSL_CA=
PORT=3000
# Bắt buộc. Tạo bằng: openssl rand -base64 48
JWT_SECRET=doi-thanh-chuoi-bi-mat-ngau-nhien
JWT_EXPIRES_IN=8h
# Origin của FE được gọi thẳng BE từ trình duyệt (cách nhau bằng dấu phẩy). Bỏ qua nếu FE gọi qua proxy /backend của Next.
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
