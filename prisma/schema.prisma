generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS (Dựa trên các CONSTRAINT CHECK trong SQL)
// ------------------------------------------------------

enum LoaiNguoiDung {
  SINH_VIEN
  GIANG_VIEN
  CAN_BO
}

enum TrangThaiNguoiDung {
  HOAT_DONG
  TAM_KHOA
  NGUNG
}

enum VaiTroTaiKhoan {
  ADMIN
  THU_THU
  BAN_DOC
}

enum TrangThaiTaiKhoan {
  HOAT_DONG
  KHOA
}

enum TinhTrangBanSach {
  SAN_SANG
  DANG_MUON
  HU_HONG
  MAT
  NGUNG_PHUC_VU
}

enum TrangThaiPhieuMuon {
  DANG_MUON
  HOAN_TAT
  HUY
}

enum TinhTrangTra {
  BINH_THUONG
  HU_HONG
  MAT
}

enum LoaiPhat {
  QUA_HAN
  HU_HONG
  MAT_SACH
}

enum TrangThaiPhieuPhat {
  CHUA_THANH_TOAN
  DA_THANH_TOAN
  HUY
}

enum TrangThaiDatTruoc {
  CHO_XU_LY
  SAN_SANG_NHAN
  DA_NHAN
  HUY
  HET_HAN
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model TheLoai {
  id           Int     @id @default(autoincrement())
  ma_the_loai  String  @unique @db.VarChar(20)
  ten_the_loai String  @db.VarChar(120)
  mo_ta        String? @db.VarChar(255)

  sachs Sach[]

  @@map("the_loai")
}

model NhaXuatBan {
  id      Int     @id @default(autoincrement())
  ma_nxb  String  @unique @db.VarChar(20)
  ten_nxb String  @db.VarChar(160)
  dia_chi String? @db.VarChar(255)
  email   String? @db.VarChar(120)
  sdt     String? @db.VarChar(20)

  sachs Sach[]

  @@map("nha_xuat_ban")
}

model TacGia {
  id          BigInt  @id @default(autoincrement())
  ma_tac_gia  String  @unique @db.VarChar(20)
  ten_tac_gia String  @db.VarChar(160)
  quoc_tich   String? @db.VarChar(80)
  nam_sinh    Int?    @db.SmallInt

  sach_tac_gias SachTacGia[]

  @@map("tac_gia")
}

model NguoiDung {
  id              Int                @id @default(autoincrement())
  ma_nguoi_dung   String             @unique @db.VarChar(20)
  ho_ten          String             @db.VarChar(160)
  loai_nguoi_dung LoaiNguoiDung
  email           String?            @unique @db.VarChar(120)
  sdt             String?            @db.VarChar(20)
  khoa_don_vi     String?            @db.VarChar(160)
  trang_thai      TrangThaiNguoiDung @default(HOAT_DONG)
  created_at      DateTime           @default(now())

  tai_khoan           TaiKhoan?
  phieu_muons         PhieuMuon[]    @relation("NguoiMuon")
  phieu_muon_cap_nhat PhieuMuon[]    @relation("NhanVienXuly")
  dat_truocs          DatTruoc[]
  nhat_ky_hanh_vis    NhatKyHanhVi[]

  @@map("nguoi_dung")
}

model TaiKhoan {
  id            Int               @id @default(autoincrement())
  nguoi_dung_id Int               @unique
  ten_dang_nhap String            @unique @db.VarChar(80)
  mat_khau_hash String            @db.VarChar(255)
  vai_tro       VaiTroTaiKhoan
  trang_thai    TrangThaiTaiKhoan @default(HOAT_DONG)
  created_at    DateTime          @default(now())

  nguoi_dung NguoiDung @relation(fields: [nguoi_dung_id], references: [id])

  @@map("tai_khoan")
}

model Sach {
  id           Int     @id @default(autoincrement())
  ma_sach      String  @unique @db.VarChar(20)
  isbn         String? @unique @db.VarChar(20)
  ten_sach     String  @db.VarChar(255)
  the_loai_id  Int
  nxb_id       Int
  nam_xuat_ban Int?    @db.SmallInt
  ngon_ngu     String? @default("Tieng Viet") @db.VarChar(50)
  mo_ta        String? @db.Text

  the_loai     TheLoai    @relation(fields: [the_loai_id], references: [id])
  nha_xuat_ban NhaXuatBan @relation(fields: [nxb_id], references: [id])

  sach_tac_gias SachTacGia[]
  ban_sachs     BanSach[]
  dat_truocs    DatTruoc[]

  @@index([ten_sach], map: "idx_sach_ten")
  @@map("sach")
}

model SachTacGia {
  sach_id    Int
  tac_gia_id BigInt

  sach    Sach   @relation(fields: [sach_id], references: [id])
  tac_gia TacGia @relation(fields: [tac_gia_id], references: [id])

  @@id([sach_id, tac_gia_id])
  @@map("sach_tac_gia")
}

model BanSach {
  id          BigInt           @id @default(autoincrement())
  ma_ban_sach String           @unique @db.VarChar(30)
  sach_id     Int
  vi_tri_ke   String           @db.VarChar(50)
  ngay_nhap   DateTime         @db.Date
  tinh_trang  TinhTrangBanSach @default(SAN_SANG)

  sach           Sach          @relation(fields: [sach_id], references: [id])
  ct_phieu_muons CtPhieuMuon[]

  @@index([tinh_trang], map: "idx_bs_tinh_trang")
  @@map("ban_sach")
}

model PhieuMuon {
  id            BigInt             @id @default(autoincrement())
  ma_phieu      String?            @unique @db.VarChar(20)
  nguoi_dung_id Int
  nhan_vien_id  Int?
  ngay_muon     DateTime           @default(now()) @db.Date
  trang_thai    TrangThaiPhieuMuon @default(DANG_MUON)

  nguoi_dung NguoiDung  @relation("NguoiMuon", fields: [nguoi_dung_id], references: [id])
  nhan_vien  NguoiDung? @relation("NhanVienXuly", fields: [nhan_vien_id], references: [id])

  ct_phieu_muons CtPhieuMuon[]

  @@map("phieu_muon")
}

model CtPhieuMuon {
  id             BigInt        @id @default(autoincrement())
  phieu_muon_id  BigInt
  ban_sach_id    BigInt
  han_tra        DateTime      @db.Date
  ngay_tra       DateTime?     @db.Date
  so_lan_gia_han Int           @default(0) @db.TinyInt
  tinh_trang_tra TinhTrangTra?

  phieu_muon  PhieuMuon   @relation(fields: [phieu_muon_id], references: [id])
  ban_sach    BanSach     @relation(fields: [ban_sach_id], references: [id])
  phieu_phats PhieuPhat[]

  @@unique([phieu_muon_id, ban_sach_id], map: "uq_ctpm")
  @@index([han_tra, ngay_tra], map: "idx_ctpm_han_tra")
  @@map("ct_phieu_muon")
}

model PhieuPhat {
  id               BigInt             @id @default(autoincrement())
  ct_phieu_muon_id BigInt
  loai_phat        LoaiPhat
  so_tien          Decimal            @db.Decimal(12, 2)
  ly_do            String?            @db.VarChar(255)
  trang_thai       TrangThaiPhieuPhat @default(CHUA_THANH_TOAN)
  ngay_tao         DateTime           @default(now()) @db.Date
  ngay_thanh_toan  DateTime?          @db.Date

  ct_phieu_muon CtPhieuMuon @relation(fields: [ct_phieu_muon_id], references: [id])

  @@index([trang_thai], map: "idx_pp_trang_thai")
  @@map("phieu_phat")
}

model DatTruoc {
  id            Int               @id @default(autoincrement())
  nguoi_dung_id Int
  sach_id       Int
  ngay_dat      DateTime          @default(now())
  han_giu       DateTime?
  trang_thai    TrangThaiDatTruoc @default(CHO_XU_LY)

  nguoi_dung NguoiDung @relation(fields: [nguoi_dung_id], references: [id])
  sach       Sach      @relation(fields: [sach_id], references: [id])

  @@index([trang_thai], map: "idx_dt_trang_thai")
  @@map("dat_truoc")
}

model NhatKyHanhVi {
  id            Int      @id @default(autoincrement())
  nguoi_dung_id Int?
  loai_hanh_vi  String   @db.VarChar(30)
  doi_tuong     String?  @db.VarChar(50)
  doi_tuong_id  Int?
  mo_ta         String?  @db.VarChar(255)
  thoi_gian     DateTime @default(now())

  nguoi_dung NguoiDung? @relation(fields: [nguoi_dung_id], references: [id])

  @@map("nhat_ky_hanh_vi")
}
