generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TheLoai {
  id         BigInt  @id @default(autoincrement())
  maTheLoai  String  @unique(map: "ma_the_loai") @map("ma_the_loai") @db.VarChar(20)
  tenTheLoai String  @map("ten_the_loai") @db.VarChar(120)
  moTa       String? @map("mo_ta") @db.VarChar(255)
  sachs      Sach[]

  @@map("the_loai")
}

model NhaXuatBan {
  id     BigInt  @id @default(autoincrement())
  maNxb  String  @unique(map: "ma_nxb") @map("ma_nxb") @db.VarChar(20)
  tenNxb String  @map("ten_nxb") @db.VarChar(160)
  diaChi String? @map("dia_chi") @db.VarChar(255)
  email  String? @db.VarChar(120)
  sdt    String? @db.VarChar(20)
  sachs  Sach[]

  @@map("nha_xuat_ban")
}

model TacGia {
  id          BigInt       @id @default(autoincrement())
  maTacGia    String       @unique(map: "ma_tac_gia") @map("ma_tac_gia") @db.VarChar(20)
  tenTacGia   String       @map("ten_tac_gia") @db.VarChar(160)
  quocTich    String?      @map("quoc_tich") @db.VarChar(80)
  namSinh     Int?         @map("nam_sinh") @db.SmallInt
  sachTacGias SachTacGia[]

  @@index([tenTacGia], map: "idx_tac_gia_ten")
  @@map("tac_gia")
}

model NguoiDung {
  id               BigInt          @id @default(autoincrement())
  maNguoiDung      String          @unique(map: "ma_nguoi_dung") @map("ma_nguoi_dung") @db.VarChar(20)
  hoTen            String          @map("ho_ten") @db.VarChar(160)
  loaiNguoiDung    String          @map("loai_nguoi_dung") @db.VarChar(20)
  email            String?         @unique(map: "email") @db.VarChar(120)
  sdt              String?         @db.VarChar(20)
  khoaDonVi        String?         @map("khoa_don_vi") @db.VarChar(160)
  trangThai        String          @default("HOAT_DONG") @map("trang_thai") @db.VarChar(20)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  datTruocs        DatTruoc[]
  nhatKyHanhVis    NhatKyHanhVi[]
  phienDangNhaps   PhienDangNhap[]
  phieuMuons       PhieuMuon[]     @relation("NguoiMuon")
  phieuMuonCapNhat PhieuMuon[]     @relation("NhanVienXuly")
  taiKhoan         TaiKhoan?

  @@map("nguoi_dung")
}

model TaiKhoan {
  id          BigInt    @id @default(autoincrement())
  nguoiDungId BigInt    @unique(map: "nguoi_dung_id") @map("nguoi_dung_id")
  tenDangNhap String    @unique(map: "ten_dang_nhap") @map("ten_dang_nhap") @db.VarChar(80)
  muoi        String    @db.Char(32)
  matKhauHash String    @map("mat_khau_hash") @db.VarChar(255)
  vaiTro      String    @map("vai_tro") @db.VarChar(20)
  trangThai   String    @default("HOAT_DONG") @map("trang_thai") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  nguoiDung   NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tk_nguoi_dung")

  @@map("tai_khoan")
}

model Sach {
  id          BigInt       @id @default(autoincrement())
  maSach      String       @unique(map: "ma_sach") @map("ma_sach") @db.VarChar(20)
  isbn        String?      @unique(map: "isbn") @db.VarChar(20)
  tenSach     String       @map("ten_sach") @db.VarChar(255)
  theLoaiId   BigInt       @map("the_loai_id")
  nxbId       BigInt       @map("nxb_id")
  namXuatBan  Int?         @map("nam_xuat_ban") @db.SmallInt
  ngonNgu     String       @default("Tiếng Việt") @map("ngon_ngu") @db.VarChar(50)
  giaBia      Decimal?     @map("gia_bia") @db.Decimal(12, 2)
  moTa        String?      @map("mo_ta") @db.Text
  banSachs    BanSach[]
  datTruocs   DatTruoc[]
  nhaXuatBan  NhaXuatBan   @relation(fields: [nxbId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sach_nxb")
  theLoai     TheLoai      @relation(fields: [theLoaiId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sach_the_loai")
  sachTacGias SachTacGia[]

  @@index([tenSach], map: "idx_sach_ten")
  @@index([nxbId], map: "fk_sach_nxb")
  @@index([theLoaiId], map: "fk_sach_the_loai")
  @@fulltext([tenSach, moTa], map: "ft_sach_ten_mo_ta")
  @@map("sach")
}

model SachTacGia {
  sachId   BigInt @map("sach_id")
  tacGiaId BigInt @map("tac_gia_id")
  sach     Sach   @relation(fields: [sachId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_stg_sach")
  tacGia   TacGia @relation(fields: [tacGiaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_stg_tac_gia")

  @@id([sachId, tacGiaId])
  @@index([tacGiaId], map: "fk_stg_tac_gia")
  @@map("sach_tac_gia")
}

model BanSach {
  id           BigInt        @id @default(autoincrement())
  maBanSach    String        @unique(map: "ma_ban_sach") @map("ma_ban_sach") @db.VarChar(30)
  sachId       BigInt        @map("sach_id")
  viTriKe      String        @map("vi_tri_ke") @db.VarChar(50)
  ngayNhap     DateTime      @map("ngay_nhap") @db.Date
  tinhTrang    String        @default("SAN_SANG") @map("tinh_trang") @db.VarChar(20)
  sach         Sach          @relation(fields: [sachId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bs_sach")
  ctPhieuMuons CtPhieuMuon[]
  datTruocs    DatTruoc[]

  @@unique([id, sachId], map: "uq_bs_id_sach")
  @@index([tinhTrang], map: "idx_bs_tinh_trang")
  @@index([sachId, tinhTrang], map: "idx_bs_sach_tinh_trang")
  @@map("ban_sach")
}

model PhieuMuon {
  id           BigInt        @id @default(autoincrement())
  maPhieu      String?       @unique(map: "ma_phieu") @map("ma_phieu") @db.VarChar(20)
  nguoiDungId  BigInt        @map("nguoi_dung_id")
  nhanVienId   BigInt        @map("nhan_vien_id")
  ngayMuon     DateTime      @default(dbgenerated("(curdate())")) @map("ngay_muon") @db.Date
  trangThai    String        @default("DANG_MUON") @map("trang_thai") @db.VarChar(20)
  ctPhieuMuons CtPhieuMuon[]
  nguoiDung    NguoiDung     @relation("NguoiMuon", fields: [nguoiDungId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pm_nguoi_dung")
  nhanVien     NguoiDung     @relation("NhanVienXuly", fields: [nhanVienId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pm_nhan_vien")

  @@index([nguoiDungId], map: "fk_pm_nguoi_dung")
  @@index([nhanVienId], map: "fk_pm_nhan_vien")
  @@map("phieu_muon")
}

model CtPhieuMuon {
  id              BigInt      @id @default(autoincrement())
  phieuMuonId     BigInt      @map("phieu_muon_id")
  banSachId       BigInt      @map("ban_sach_id")
  hanTra          DateTime    @map("han_tra") @db.Date
  ngayTra         DateTime?   @map("ngay_tra") @db.Date
  soLanGiaHan     Int         @default(0) @map("so_lan_gia_han") @db.TinyInt
  tinhTrangTra    String?     @map("tinh_trang_tra") @db.VarChar(20)
  /// Cột GENERATED trong DB (chỉ đọc, không được ghi qua Prisma)
  banSachDangMuon BigInt?     @unique(map: "uq_ctpm_dang_muon") @map("ban_sach_dang_muon")
  banSach         BanSach     @relation(fields: [banSachId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ctpm_ban_sach")
  phieuMuon       PhieuMuon   @relation(fields: [phieuMuonId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ctpm_phieu")
  phieuPhats      PhieuPhat[]

  @@unique([phieuMuonId, banSachId], map: "uq_ctpm")
  @@index([hanTra, ngayTra], map: "idx_ctpm_han_tra")
  @@index([banSachId], map: "fk_ctpm_ban_sach")
  @@map("ct_phieu_muon")
}

model PhieuPhat {
  id            BigInt      @id @default(autoincrement())
  ctPhieuMuonId BigInt      @map("ct_phieu_muon_id")
  loaiPhat      String      @map("loai_phat") @db.VarChar(20)
  soTien        Decimal     @map("so_tien") @db.Decimal(12, 2)
  lyDo          String?     @map("ly_do") @db.VarChar(255)
  trangThai     String      @default("CHUA_THANH_TOAN") @map("trang_thai") @db.VarChar(20)
  ngayTao       DateTime    @default(dbgenerated("(curdate())")) @map("ngay_tao") @db.Date
  ngayThanhToan DateTime?   @map("ngay_thanh_toan") @db.Date
  ctPhieuMuon   CtPhieuMuon @relation(fields: [ctPhieuMuonId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pp_ctpm")

  @@unique([ctPhieuMuonId, loaiPhat], map: "uq_pp_ct_loai")
  @@index([trangThai], map: "idx_pp_trang_thai")
  @@map("phieu_phat")
}

model DatTruoc {
  id               BigInt    @id @default(autoincrement())
  nguoiDungId      BigInt    @map("nguoi_dung_id")
  sachId           BigInt    @map("sach_id")
  banSachId        BigInt?   @map("ban_sach_id")
  ngayDat          DateTime  @default(now()) @map("ngay_dat") @db.DateTime(0)
  hanGiu           DateTime? @map("han_giu") @db.DateTime(0)
  trangThai        String    @default("CHO_XU_LY") @map("trang_thai") @db.VarChar(20)
  /// Cột GENERATED trong DB (chỉ đọc, không được ghi qua Prisma)
  khoaDangHoatDong String?   @unique(map: "uq_dt_dang_hoat_dong") @map("khoa_dang_hoat_dong") @db.VarChar(50)
  /// Cột GENERATED trong DB (chỉ đọc, không được ghi qua Prisma)
  banSachDangGiu   BigInt?   @unique(map: "uq_dt_dang_giu") @map("ban_sach_dang_giu")
  banSach          BanSach?  @relation(fields: [banSachId, sachId], references: [id, sachId], onDelete: NoAction, onUpdate: NoAction, map: "fk_dt_ban_sach")
  nguoiDung        NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dt_nguoi_dung")
  sach             Sach      @relation(fields: [sachId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dt_sach")

  @@index([trangThai], map: "idx_dt_trang_thai")
  @@index([banSachId, sachId], map: "fk_dt_ban_sach")
  @@index([nguoiDungId], map: "fk_dt_nguoi_dung")
  @@index([sachId, trangThai, ngayDat], map: "idx_dt_hang_doi")
  @@map("dat_truoc")
}

model NhatKyHanhVi {
  id          BigInt     @id @default(autoincrement())
  nguoiDungId BigInt?    @map("nguoi_dung_id")
  loaiHanhVi  String     @map("loai_hanh_vi") @db.VarChar(30)
  doiTuong    String?    @map("doi_tuong") @db.VarChar(50)
  doiTuongId  BigInt?    @map("doi_tuong_id")
  moTa        String?    @map("mo_ta") @db.VarChar(255)
  thoiGian    DateTime   @default(now()) @map("thoi_gian") @db.DateTime(0)
  nguoiDung   NguoiDung? @relation(fields: [nguoiDungId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_nkhv_nguoi_dung")

  @@index([nguoiDungId], map: "fk_nkhv_nguoi_dung")
  @@index([loaiHanhVi, doiTuong, doiTuongId, thoiGian], map: "idx_nkhv_doi_tuong")
  @@index([thoiGian], map: "idx_nkhv_thoi_gian")
  @@map("nhat_ky_hanh_vi")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ThamSo {
  maThamSo String  @id @map("ma_tham_so") @db.VarChar(40)
  giaTri   Decimal @map("gia_tri") @db.Decimal(12, 2)
  donVi    String? @map("don_vi") @db.VarChar(20)
  moTa     String? @map("mo_ta") @db.VarChar(255)

  @@map("tham_so")
}

model PhienDangNhap {
  tokenHash   String    @id @map("token_hash") @db.Char(64)
  nguoiDungId BigInt    @map("nguoi_dung_id")
  taoLuc      DateTime  @default(now()) @map("tao_luc") @db.DateTime(0)
  hetHan      DateTime  @map("het_han") @db.DateTime(0)
  daDangXuat  Boolean   @default(false) @map("da_dang_xuat")
  nguoiDung   NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pdn_nguoi_dung")

  @@index([nguoiDungId], map: "fk_pdn_nguoi_dung")
  @@index([hetHan], map: "idx_pdn_het_han")
  @@map("phien_dang_nhap")
}
