generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ------------------------------------------------------
// ENUMS (Dựa trên các CONSTRAINT CHECK trong SQL)
// ------------------------------------------------------

enum LoaiNguoiDung {
  SINH_VIEN
  GIANG_VIEN
  CAN_BO
}

enum TrangThaiNguoiDung {
  HOAT_DONG
  TAM_KHOA
  NGUNG
}

enum VaiTroTaiKhoan {
  ADMIN
  THU_THU
  BAN_DOC
}

enum TrangThaiTaiKhoan {
  HOAT_DONG
  KHOA
}

enum TinhTrangBanSach {
  SAN_SANG
  DANG_MUON
  HU_HONG
  MAT
  NGUNG_PHUC_VU
}

enum TrangThaiPhieuMuon {
  DANG_MUON
  HOAN_TAT
  HUY
}

enum TinhTrangTra {
  BINH_THUONG
  HU_HONG
  MAT
}

enum LoaiPhat {
  QUA_HAN
  HU_HONG
  MAT_SACH
}

enum TrangThaiPhieuPhat {
  CHUA_THANH_TOAN
  DA_THANH_TOAN
  HUY
}

enum TrangThaiDatTruoc {
  CHO_XU_LY
  SAN_SANG_NHAN
  DA_NHAN
  HUY
  HET_HAN
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model TheLoai {
  id         BigInt  @id @default(autoincrement())
  maTheLoai  String  @unique @map("ma_the_loai") @db.VarChar(20)
  tenTheLoai String  @map("ten_the_loai") @db.VarChar(120)
  moTa       String? @map("mo_ta") @db.VarChar(255)

  sachs Sach[]

  @@map("the_loai")
}

model NhaXuatBan {
  id     BigInt  @id @default(autoincrement())
  maNxb  String  @unique @map("ma_nxb") @db.VarChar(20)
  tenNxb String  @map("ten_nxb") @db.VarChar(160)
  diaChi String? @map("dia_chi") @db.VarChar(255)
  email  String? @db.VarChar(120)
  sdt    String? @db.VarChar(20)

  sachs Sach[]

  @@map("nha_xuat_ban")
}

model TacGia {
  id        BigInt  @id @default(autoincrement())
  maTacGia  String  @unique @map("ma_tac_gia") @db.VarChar(20)
  tenTacGia String  @map("ten_tac_gia") @db.VarChar(160)
  quocTich  String? @map("quoc_tich") @db.VarChar(80)
  namSinh   Int?    @map("nam_sinh") @db.SmallInt

  sachTacGias SachTacGia[]

  @@map("tac_gia")
}

model NguoiDung {
  id            BigInt             @id @default(autoincrement())
  maNguoiDung   String             @unique @map("ma_nguoi_dung") @db.VarChar(20)
  hoTen         String             @map("ho_ten") @db.VarChar(160)
  loaiNguoiDung LoaiNguoiDung      @map("loai_nguoi_dung")
  email         String?            @unique @db.VarChar(120)
  sdt           String?            @db.VarChar(20)
  khoaDonVi     String?            @map("khoa_don_vi") @db.VarChar(160)
  trangThai     TrangThaiNguoiDung @default(HOAT_DONG) @map("trang_thai")
  createdAt     DateTime           @default(now()) @map("created_at")

  taiKhoan         TaiKhoan?
  phieuMuons       PhieuMuon[]    @relation("NguoiMuon")
  phieuMuonCapNhat PhieuMuon[]    @relation("NhanVienXuly")
  datTruocs        DatTruoc[]
  nhatKyHanhVis    NhatKyHanhVi[]

  @@map("nguoi_dung")
}

model TaiKhoan {
  id          BigInt            @id @default(autoincrement())
  nguoiDungId BigInt            @unique @map("nguoi_dung_id")
  tenDangNhap String            @unique @map("ten_dang_nhap") @db.VarChar(80)
  matKhauHash String            @map("mat_khau_hash") @db.VarChar(255)
  vaiTro      VaiTroTaiKhoan    @map("vai_tro")
  trangThai   TrangThaiTaiKhoan @default(HOAT_DONG) @map("trang_thai")
  createdAt   DateTime          @default(now()) @map("created_at")

  nguoiDung NguoiDung @relation(fields: [nguoiDungId], references: [id])

  @@map("tai_khoan")
}

model Sach {
  id         BigInt  @id @default(autoincrement())
  maSach     String  @unique @map("ma_sach") @db.VarChar(20)
  isbn       String? @unique @db.VarChar(20)
  tenSach    String  @map("ten_sach") @db.VarChar(255)
  theLoaiId  BigInt  @map("the_loai_id")
  nxbId      BigInt  @map("nxb_id")
  namXuatBan Int?    @map("nam_xuat_ban") @db.SmallInt
  ngonNgu    String? @default("Tieng Viet") @map("ngon_ngu") @db.VarChar(50)
  moTa       String? @map("mo_ta") @db.Text

  theLoai    TheLoai    @relation(fields: [theLoaiId], references: [id])
  nhaXuatBan NhaXuatBan @relation(fields: [nxbId], references: [id])

  sachTacGias SachTacGia[]
  banSachs    BanSach[]
  datTruocs   DatTruoc[]

  @@index([tenSach], map: "idx_sach_ten")
  @@map("sach")
}

model SachTacGia {
  sachId   BigInt @map("sach_id")
  tacGiaId BigInt @map("tac_gia_id")

  sach   Sach   @relation(fields: [sachId], references: [id])
  tacGia TacGia @relation(fields: [tacGiaId], references: [id])

  @@id([sachId, tacGiaId])
  @@map("sach_tac_gia")
}

model BanSach {
  id        BigInt           @id @default(autoincrement())
  maBanSach String           @unique @map("ma_ban_sach") @db.VarChar(30)
  sachId    BigInt           @map("sach_id")
  viTriKe   String           @map("vi_tri_ke") @db.VarChar(50)
  ngayNhap  DateTime         @map("ngay_nhap") @db.Date
  tinhTrang TinhTrangBanSach @default(SAN_SANG) @map("tinh_trang")

  sach         Sach          @relation(fields: [sachId], references: [id])
  ctPhieuMuons CtPhieuMuon[]

  @@index([tinhTrang], map: "idx_bs_tinh_trang")
  @@map("ban_sach")
}

model PhieuMuon {
  id          BigInt             @id @default(autoincrement())
  maPhieu     String?            @unique @map("ma_phieu") @db.VarChar(20)
  nguoiDungId BigInt             @map("nguoi_dung_id")
  nhanVienId  BigInt?            @map("nhan_vien_id")
  ngayMuon    DateTime           @default(now()) @map("ngay_muon") @db.Date
  trangThai   TrangThaiPhieuMuon @default(DANG_MUON) @map("trang_thai")

  nguoiDung NguoiDung  @relation("NguoiMuon", fields: [nguoiDungId], references: [id])
  nhanVien  NguoiDung? @relation("NhanVienXuly", fields: [nhanVienId], references: [id])

  ctPhieuMuons CtPhieuMuon[]

  @@map("phieu_muon")
}

model CtPhieuMuon {
  id           BigInt        @id @default(autoincrement())
  phieuMuonId  BigInt        @map("phieu_muon_id")
  banSachId    BigInt        @map("ban_sach_id")
  hanTra       DateTime      @map("han_tra") @db.Date
  ngayTra      DateTime?     @map("ngay_tra") @db.Date
  soLanGiaHan  Int           @default(0) @map("so_lan_gia_han") @db.TinyInt
  tinhTrangTra TinhTrangTra? @map("tinh_trang_tra")

  phieuMuon  PhieuMuon   @relation(fields: [phieuMuonId], references: [id])
  banSach    BanSach     @relation(fields: [banSachId], references: [id])
  phieuPhats PhieuPhat[]

  @@unique([phieuMuonId, banSachId], map: "uq_ctpm")
  @@index([hanTra, ngayTra], map: "idx_ctpm_han_tra")
  @@map("ct_phieu_muon")
}

model PhieuPhat {
  id            BigInt             @id @default(autoincrement())
  ctPhieuMuonId BigInt             @map("ct_phieu_muon_id")
  loaiPhat      LoaiPhat           @map("loai_phat")
  soTien        Decimal            @map("so_tien") @db.Decimal(12, 2)
  lyDo          String?            @map("ly_do") @db.VarChar(255)
  trangThai     TrangThaiPhieuPhat @default(CHUA_THANH_TOAN) @map("trang_thai")
  ngayTao       DateTime           @default(now()) @map("ngay_tao") @db.Date
  ngayThanhToan DateTime?          @map("ngay_thanh_toan") @db.Date

  ctPhieuMuon CtPhieuMuon @relation(fields: [ctPhieuMuonId], references: [id])

  @@index([trangThai], map: "idx_pp_trang_thai")
  @@map("phieu_phat")
}

model DatTruoc {
  id          BigInt            @id @default(autoincrement())
  nguoiDungId BigInt            @map("nguoi_dung_id")
  sachId      BigInt            @map("sach_id")
  ngayDat     DateTime          @default(now()) @map("ngay_dat")
  hanGiu      DateTime?         @map("han_giu")
  trangThai   TrangThaiDatTruoc @default(CHO_XU_LY) @map("trang_thai")

  nguoiDung NguoiDung @relation(fields: [nguoiDungId], references: [id])
  sach      Sach      @relation(fields: [sachId], references: [id])

  @@index([trangThai], map: "idx_dt_trang_thai")
  @@map("dat_truoc")
}

model NhatKyHanhVi {
  id          BigInt   @id @default(autoincrement())
  nguoiDungId BigInt?  @map("nguoi_dung_id")
  loaiHanhVi  String   @map("loai_hanh_vi") @db.VarChar(30)
  doiTuong    String?  @map("doi_tuong") @db.VarChar(50)
  doiTuongId  BigInt?  @map("doi_tuong_id")
  moTa        String?  @map("mo_ta") @db.VarChar(255)
  thoiGian    DateTime @default(now()) @map("thoi_gian")

  nguoiDung NguoiDung? @relation(fields: [nguoiDungId], references: [id])

  @@map("nhat_ky_hanh_vi")
}
